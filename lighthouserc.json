{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/id.html", "/en.html", "/id/privacy.html"],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 1
          }
        ]
      }
    }
  }
}
