# Domain production (tanpa garis miring di akhir)
SITE_URL=https://www.example.co.id

# Measurement ID Google Analytics 4 dari project Firebase (G-XXXXXXXXXX).
# Kosongkan untuk menonaktifkan analytics dan banner cookie.
PUBLIC_GA_MEASUREMENT_ID=

# true = tambahkan <meta name="robots" content="noindex"> (dipakai untuk preview channel)
PUBLIC_NOINDEX=false
