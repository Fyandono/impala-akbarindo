---
import { getEntry, render } from 'astro:content';
import PageHero from '../components/sections/PageHero.tsx';
import Container from '../components/ui/Container.astro';
import { dict, formatDate } from '../i18n';
import BaseLayout from './BaseLayout.astro';

/** Halaman teks dari src/content/pages/<slug>.md */
type Props = { slug: string };
const { slug } = Astro.props;

const entry = await getEntry('pages', slug);
if (!entry) throw new Error(`Konten tidak ditemukan: src/content/pages/${slug}.md`);
const { Content } = await render(entry);

const breadcrumbs = [
  { name: dict.nav.home, path: '/' },
  { name: entry.data.title, path: `/${slug}` },
];
---

<BaseLayout
  path={`/${slug}`}
  title={entry.data.title}
  description={entry.data.description}
  breadcrumbs={breadcrumbs}
>
  <PageHero
    title={entry.data.title}
    lead={entry.data.description}
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={dict.common.breadcrumb}
  />
  <Container class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <p class="text-small text-neutral-500">
        {dict.common.lastUpdated}:
        <time datetime={entry.data.updatedAt.toISOString()}>
          {formatDate(entry.data.updatedAt)}
        </time>
      </p>
      <div class="prose-content mt-8">
        <Content />
      </div>
    </div>
  </Container>
</BaseLayout>
