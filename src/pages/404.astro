---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.tsx';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.tsx';
import { dict } from '../i18n';

// Firebase menyajikan halaman ini untuk semua URL yang tidak ditemukan.
const { notFound } = dict;
---

<BaseLayout title={`404 — ${notFound.title}`} description={notFound.body} path="/404">
  <section class="bg-primary-950 flex min-h-svh items-center text-white">
    <Container class="py-section-lg">
      <Eyebrow tone="dark">404</Eyebrow>
      <h1 class="text-display mt-6 text-white">{notFound.title}</h1>
      <p class="text-primary-100 text-body-lg mt-6 max-w-xl">{notFound.body}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/" variant="accent">
          {notFound.back}
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
