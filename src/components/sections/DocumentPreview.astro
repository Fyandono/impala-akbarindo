---
/**
 * Dialog pratinjau dokumen legalitas (satu per halaman). Dibuka oleh link `data-document-preview`
 * di LegalitySection lewat src/scripts/document-preview.ts; tanpa JS link itu membuka berkasnya
 * di tab baru.
 */
export type DocumentPreviewStrings = {
  /** Label tombol tutup, mis. "Tutup pratinjau". */
  close: string;
  /** Label link berkas asli, mis. "Buka PDF". */
  openFile: string;
  /** Teks tersembunyi untuk link yang membuka tab baru. */
  opensInNewTab: string;
};

type Props = DocumentPreviewStrings;

const { close, openFile, opensInNewTab } = Astro.props;
---

<dialog
  data-document-dialog
  aria-labelledby="document-preview-title"
  class="backdrop:bg-primary-950/80 rounded-card text-primary-900 m-auto max-h-dvh w-full max-w-3xl overflow-y-auto bg-white p-0"
>
  <div class="sticky top-0 flex items-center justify-between gap-4 border-b border-neutral-200 bg-white py-2 pr-2 pl-5">
    <h2
      id="document-preview-title"
      data-dialog-title
      class="text-body font-sans font-semibold"
    ></h2>
    <button
      type="button"
      data-dialog-close
      class="inline-flex size-11 shrink-0 items-center justify-center"
    >
      <span class="sr-only">{close}</span>
      <svg viewBox="0 0 24 24" class="size-6" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75"></path>
      </svg>
    </button>
  </div>
  <img data-dialog-image alt="" decoding="async" class="w-full bg-neutral-100" />
  <div class="sticky bottom-0 flex justify-end border-t border-neutral-200 bg-white px-5 py-3">
    <a
      data-dialog-file
      target="_blank"
      rel="noopener noreferrer"
      class="text-small text-accent-700 hover:text-primary-900 font-semibold underline underline-offset-4"
    >
      {openFile}
      <span class="sr-only">{opensInNewTab}</span>
    </a>
  </div>
</dialog>

<script>
  import '../../scripts/document-preview';
</script>
