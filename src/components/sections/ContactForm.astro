---
/**
 * Form permintaan penawaran. Tidak ada server: saat dikirim, src/scripts/contact-form.ts menyusun
 * subjek & isi pesan lalu membuka aplikasi email pengunjung (mailto:). Tanpa JS, form tetap
 * terkirim lewat `action="mailto:"` (isi berupa daftar nama=nilai).
 */
import type { ContactFormData } from '../../lib/sections/contact';

type Props = ContactFormData;
const { email, strings, mail, services } = Astro.props;

const field =
  'mt-2 block w-full rounded-card border border-neutral-300 bg-white px-4 py-3 text-body text-primary-900 placeholder:text-neutral-500 transition-colors hover:border-neutral-400';
const label = 'block text-small font-semibold text-primary-900';
---

<div class="rounded-card border border-neutral-200 bg-neutral-50 p-6 sm:p-10" data-reveal="scale">
  <h3 class="text-title">{strings.title}</h3>
  <p class="mt-3 text-small leading-relaxed text-neutral-600">{strings.lead}</p>

  <form
    class="mt-8 space-y-6"
    action={`mailto:${email}`}
    method="post"
    enctype="text/plain"
    data-contact-form
    data-email={email}
    data-mail={JSON.stringify(mail)}
  >
    <div>
      <label for="cf-name" class={label}>
        {strings.name} <span class="font-normal text-neutral-500">({strings.required})</span>
      </label>
      <input
        id="cf-name"
        name="name"
        type="text"
        required
        autocomplete="name"
        placeholder={strings.namePlaceholder}
        class={field}
      />
    </div>

    <div>
      <label for="cf-organization" class={label}>
        {strings.organization}{' '}
        <span class="font-normal text-neutral-500">({strings.required})</span>
      </label>
      <input
        id="cf-organization"
        name="organization"
        type="text"
        required
        autocomplete="organization"
        placeholder={strings.organizationPlaceholder}
        class={field}
      />
    </div>

    <div>
      <label for="cf-service" class={label}>
        {strings.service}
      </label>
      <select id="cf-service" name="service" class={field}>
        {services.map((service) => (
          <option value={service}>{service}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="cf-message" class={label}>
        {strings.message}
      </label>
      <textarea
        id="cf-message"
        name="message"
        rows="4"
        placeholder={strings.messagePlaceholder}
        class={field}
      ></textarea>
    </div>

    <button
      type="submit"
      class="group inline-flex min-h-13 w-full cursor-pointer items-center justify-center gap-3 rounded-card bg-accent-700 px-7 text-small font-medium tracking-wide text-white transition-colors duration-200 hover:bg-accent-600"
    >
      <svg viewBox="0 0 24 24" class="size-4" fill="none" aria-hidden="true">
        <path
          d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm-1 1 9 7 9-7"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        ></path>
      </svg>
      {strings.submit}
    </button>
    <p class="text-caption text-neutral-500">{strings.note}</p>
  </form>
</div>

<script>
  import '../../scripts/contact-form';
</script>
