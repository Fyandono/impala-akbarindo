---
/**
 * Section teks Markdown (mis. Tata Kelola, Keberlanjutan): judul lengket di kiri, isi di kanan.
 * Dipertahankan sebagai .astro karena isinya `<Content />` dari render Markdown (slot Astro).
 * Subjudul di Markdown memakai `###` karena judul section sudah `<h2>`.
 */
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.tsx';
import type { SectionTone } from '../ui/Section.tsx';

type Props = {
  id: string;
  index?: string;
  eyebrow: string;
  title: string;
  lead?: string;
  tone?: SectionTone;
};
const { id, index, eyebrow, title, lead, tone } = Astro.props;
const titleId = `${id}-title`;
---

<Section id={id} labelledBy={titleId} tone={tone} containerClass="grid gap-12 lg:grid-cols-12">
  <SectionHeading
    id={titleId}
    index={index}
    eyebrow={eyebrow}
    title={title}
    lead={lead}
    className="lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
  />
  <div class="prose-content lg:col-span-6 lg:col-start-7" data-reveal>
    <slot />
  </div>
</Section>
