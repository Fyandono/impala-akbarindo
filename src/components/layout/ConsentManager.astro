  hidden
  data-ga-id={measurementId}
  data-strings={JSON.stringify(dict.consent)}
  data-cookies-url="/cookies"
  data-cookies-label={dict.nav.cookies}
></div>

<script>
  import '../../scripts/consent';
</script>
